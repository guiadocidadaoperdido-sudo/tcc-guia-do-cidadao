# Copie este arquivo para .env e troque os valores.

# Chave usada para assinar a sessão e os tokens CSRF.
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria

# Endereço do banco PostgreSQL: postgresql://usuario:senha@servidor:porta/banco
# Sem esta linha, o sistema usa um arquivo SQLite local (instance/guia.db).
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/guia_cidadao

# Use 1 quando o site estiver publicado com HTTPS (RNF07).
COOKIE_SEGURO=0

# ---------- E-mail do projeto (link de "esqueci minha senha") ----------
# Sem nada abaixo, o link aparece só no terminal (bom para testar no PC).
#
# No PC, pelo Gmail: ative a verificação em duas etapas na conta do projeto e
# gere uma "senha de app" (Conta Google > Segurança > Senhas de app).
# Cole a senha de app aqui, sem espaços. NÃO é a senha normal do Gmail.
MAIL_USUARIO=guiadocidadaoperdido@gmail.com
MAIL_SENHA=
#
# No Render, use o Brevo (o plano grátis do Render bloqueia o SMTP do Gmail).
# Crie a chave em app.brevo.com > SMTP & API > API Keys. Se ela estiver
# preenchida, o site usa o Brevo em vez do Gmail.
BREVO_API_KEY=

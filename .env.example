# Copie este arquivo para .env e troque os valores.

# Chave usada para assinar a sessão e os tokens CSRF.
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria

# Endereço do banco PostgreSQL: postgresql://usuario:senha@servidor:porta/banco
# Sem esta linha, o sistema usa um arquivo SQLite local (instance/guia.db).
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/guia_cidadao

# Use 1 quando o site estiver publicado com HTTPS (RNF07).
COOKIE_SEGURO=0
